# Bearer token the mobile app (or any client) must send. Generate with: openssl rand -hex 32
SUNNIE_API_KEY=

# Where Sunnie keeps its database and (by default) its workspace. Default: ./data
# SUNNIE_HOME=./data
# SUNNIE_HOST=127.0.0.1
# SUNNIE_PORT=8787

# Default model as "<provider>/<model-id>". Overrides agent.defaultModel in config.json.
# SUNNIE_MODEL=openrouter/openai/gpt-6-luna

# OpenRouter: the default inference endpoint. This one key is enough to run everything —
# it also reaches Jev (the tool router) when TYPESAFE_API_KEY is not set.
OPENROUTER_API_KEY=

# Optional: call Jev through TypeSafe's own API instead of through OpenRouter.
TYPESAFE_API_KEY=

# Optional: web search (web_search) and a crawler web_fetch falls back on, through Exa (exa.ai).
# The server makes these calls; the key never reaches the agent.
EXA_API_KEY=

# Optional: direct provider access (model specs like "openai/...", "deepseek/...").
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
