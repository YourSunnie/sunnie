{
  "agent": {
    "defaultModel": "openrouter/meta/muse-spark-1.3-contributor",
    "maxSteps": 40,
    "reasoning": "low"
  },
  "router": {
    "type": "jev",
    "model": "jev-latest",
    "confidenceThreshold": 0.7,
    "mode": "tool-choice"
  },
  "approvals": {
    "type": "jev",
    "threshold": 0.5,
    "onError": "ask"
  },
  "heartbeat": {
    "enabled": true,
    "intervalMinutes": 10,
    "recheckMinutes": 60
  },
  "providers": {
    "ollama": {
      "type": "openai-compatible",
      "baseURL": "http://localhost:11434/v1"
    }
  },
  "models": {
    "openrouter/meta/muse-spark-1.3-contributor": {
      "contextWindow": 1048576,
      "steer": "hint"
    },
    "openrouter/openai/gpt-6.1-sol": {
      "contextWindow": 1050000,
      "reasoning": "medium"
    },
    "openrouter/openai/gpt-5.6-luna": {
      "contextWindow": 1050000
    },
    "openrouter/deepseek/deepseek-v4.1-flash": {
      "contextWindow": 1048576
    },
    "openrouter/google/gemini-3.8-flash": {
      "contextWindow": 1048576
    },
    "anthropic/claude-haiku-5-5": {
      "contextWindow": 1000000,
      "reasoning": "medium",
      "advisor": {
        "model": "claude-opus-5-5",
        "maxUses": 3,
        "maxTokens": 2048
      }
    }
  },
  "subagents": {
    "enabled": true,
    "maxTasks": 10,
    "concurrency": 5,
    "maxSteps": 15
  },
  "browser": {
    "enabled": true,
    "headless": false,
    "idleMinutes": 30
  },
  "skills": {
    "enabled": true
  },
  "compaction": {
    "maxContextTokens": 100000,
    "threshold": 0.75,
    "keepRecentTokens": 16000
  },
  "memory": {
    "recallLimit": 6,
    "coreBlockLimit": 4000
  }
}
