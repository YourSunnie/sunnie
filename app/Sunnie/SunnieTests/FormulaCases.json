{
  "note": "Shared by api/test/formula.test.ts and SunnieTests/FormulaTests.swift: the server and the app must show the same thing for every case.",
  "state": { "people": 5, "tab": "frame", "metric": true, "done": [true, false, true, false], "price": 2.5, "zero": 0 },
  "interpolate": [
    ["{people}", "5"],
    ["{people * 0.4} kg", "2 kg"],
    ["{people * 300} g", "1,500 g"],
    ["{round(people * 1.25)}", "6"],
    ["{round(people / 3, 1)}", "1.7"],
    ["{ceil(people / 2)} trays", "3 trays"],
    ["{floor(7.9)}", "7"],
    ["{people / 3}", "1.67"],
    ["{fixed(price, 2)}", "2.50"],
    ["{price * 1000000}", "2,500,000"],
    ["{-people}", "-5"],
    ["{people % 2}", "1"],
    ["{people / zero}", "0"],
    ["{done} of 4", "2 of 4"],
    ["{done / 4}", "0.5"],
    ["{tab == 'frame' ? 'Frame' : 'Other'}", "Frame"],
    ["{tab != \"frame\"}", "false"],
    ["{metric ? round(people * 0.4, 1) + ' kg' : round(people * 0.88, 1) + ' lb'}", "2 kg"],
    ["{if(people > 6, 'two trays', 'one tray')}", "one tray"],
    ["{min(people, 3)}-{max(people, 3)}", "3-5"],
    ["{clamp(people, 1, 4)}", "4"],
    ["{abs(0 - people)}", "5"],
    ["{people >= 5 && metric}", "true"],
    ["{zero || 'none'}", "none"],
    ["{!metric}", "false"],
    ["{unknown_name}", "0"],
    ["{(people + 1) * 2}", "12"],
    ["{people × 2} and {people ÷ 2}", "10 and 2.5"],
    ["Total: {people * 12.5} €", "Total: 62.5 €"],
    ["{{literal}", "{literal}"],
    ["{people +}", "—"],
    ["{nope(1)}", "—"],
    ["no formulas here", "no formulas here"],
    ["{round(-2.5)}", "-3"],
    ["{round(2.5)}", "3"],
    ["{0.1 + 0.2}", "0.3"]
  ],
  "invalid": ["people +", "nope(1)", "'open", "people @ 2", "(people", "a ? b"]
}
